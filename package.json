{
  "name": "iic-cog-plugin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @iic/extension dev",
    "build": "pnpm --filter @iic/extension build",
    "demo": "pnpm --filter @iic/demo-site dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --trace off"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.7",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
